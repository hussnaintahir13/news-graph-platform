DATABASE_URL=sqlite:///./newrosense.db
JWT_SECRET=replace-with-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRY_MINUTES=720
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=180
# Embedding: primary then fallback. The service tries primary on first use and falls
# back automatically if the weights cannot be loaded. Set EMBEDDING_FORCE_FALLBACK=true
# to skip the primary entirely (offline development / CI).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_FORCE_FALLBACK=false
SPACY_MODEL=en_core_web_sm
RATE_LIMIT=60/minute
# Set to true to enrich entity canonicalization with Wikidata QID lookups (network call,
# cached locally afterwards). Off keeps the platform fully offline.
WIKIDATA_LOOKUP=false
