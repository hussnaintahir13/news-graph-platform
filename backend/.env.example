DATABASE_URL=sqlite:///./newsgraph.db
JWT_SECRET=replace-with-a-long-random-string
JWT_ALG=HS256
JWT_EXPIRY_MINUTES=720
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SCHEDULER_ENABLED=true
